#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    /* ============================================================
     * このキーマップは ZMK Studio 上の実機設定から復元したものです。
     *
     * Studio の物理レイアウトは "S Layout"（44キー）ですが、
     * keymap ファイルは chosen = physical_layout_l に合わせて
     * L Layout（66キー）の並びで書く必要があります。
     * そのため XS(=S Layout) に存在しない 22 箇所は &none にしてあります。
     *
     * 行ごとの位置番号（L Layout）:
     *   1行目(数字段) 0-11   … XSには無いので全て &none
     *   2行目         12-23
     *   3行目         24-37
     *   4行目         38-51
     *   5行目(親指段) 52-65
     * ============================================================ */
    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: base. home-row mods (Mod-Tap) */
        layer_0 {
            bindings = <
&none             &none             &none             &none             &none             &none             &none             &none             &none             &none             &none             &none
&none             &mt LALT Q        &kp W             &kp E             &kp R             &kp T             &kp Y             &kp U             &kp I             &kp O             &kp P             &none
&none             &mt LCTRL A       &kp S             &kp D             &kp F             &kp G             &none             &none             &kp H             &kp J             &kp K             &kp L             &mt RCTRL MINUS   &none
&none             &mt LSHFT Z       &kp X             &kp C             &kp V             &kp B             &none             &none             &kp N             &kp M             &lt 3 COMMA       &kp DOT           &mt RSHFT FSLH    &none
&none             &kp TAB           &kp LALT          &kp LCTRL         &lt 2 LANGUAGE_1  &lt 3 LANGUAGE_2  &mt RGUI ESC      &kp SPACE         &lt 2 RET         &none             &none             &none             &lt 1 DEL         &none
            >;
        };

        /* Layer 1: AML / DEL long-press. F1-F12 + mouse buttons */
        layer_1 {
            bindings = <
&none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none
&none           &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &none
&none           &trans          &trans          &mkp MB2        &mkp MB1        &trans          &none           &none           &trans          &mkp MB1        &mkp MB2        &mkp MB3        &kp F11         &none
&none           &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &mkp MB4        &trans          &mkp MB5        &kp F12         &none
&none           &bt BT_CLR_ALL  &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &none
            >;
        };

        /* Layer 2: LANG1 long-press. numbers / symbols / arrows */
        layer_2 {
            bindings = <
&none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
&none          &kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(N4)     &kp LS(N5)     &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)     &none
&none          &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &none          &none          &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans         &none
&none          &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &trans         &trans         &trans         &mkp MB1       &mkp MB2       &mkp MB3       &trans         &none
&none          &trans         &trans         &trans         &trans         &kp LG(SPACE)  &trans         &trans         &trans         &trans         &trans         &trans         &trans         &none
            >;
        };

        /* Layer 3: LANG2 / COMMA long-press. symbols / brackets / scroll layer */
        layer_3 {
            bindings = <
&none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
&none          &kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(N4)     &kp LS(N5)     &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)     &none
&none          &kp GRAVE      &kp BSLH       &kp SEMI       &kp SQT        &kp EQUAL      &none          &none          &trans         &mkp MB1       &mkp MB2       &kp LBRC       &kp RBRC       &none
&none          &kp TILDE      &kp PIPE       &kp COLON      &kp DQT        &kp PLUS       &trans         &trans         &trans         &trans         &trans         &kp LBKT       &kp RBKT       &none
&none          &trans         &trans         &trans         &trans         &trans         &trans         &trans         &kp LG(SPACE)  &trans         &trans         &trans         &trans         &none
            >;
        };
    };
};


/* ============================================================
 * トラックボール設定
 *   ノードのラベルは pointing_listener（trackball_listener ではない）
 *   定義元: boards/shields/torabo_tsuki_lp/torabo_tsuki_lp.dtsi
 *   ここを書き換えたら push → GitHub Actions → uf2 を Central 側に書き込み
 * ============================================================ */

&pointing_listener {

    /* --- 通常時（レイヤー3以外）の処理チェーン ---------------- */
    input-processors =

        /* [1] 軸の向き補正
         *     torabo_tsuki_lp_right.overlay と同じ内容。
         *     input-processors は「上書き」なので、ここに書かないと
         *     overlay 側の設定が消えて上下左右が反転する。
         *     ボールと逆に動く場合はここを調整:
         *       上下だけ反転     → INPUT_TRANSFORM_Y_INVERT
         *       左右だけ反転     → INPUT_TRANSFORM_X_INVERT
         *       縦横が入れ替わる → INPUT_TRANSFORM_XY_SWAP を | で追加
         */
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,

        /* [2] オートマウスレイヤー（AML）
         *     書式: <&zip_temp_layer レイヤー番号 タイムアウトms>
         *       レイヤー番号 … 1 = マウスボタンを置いたレイヤー
         *       タイムアウト … ボールが止まってから解除されるまでの時間
         *         短すぎ（クリック前に解除される） → 1000〜1500 へ
         *         長すぎ（タイピングに戻れない）   → 500 へ
         */
        <&zip_temp_layer 1 750>;

        /* [3] カーソル速度を変えたい場合は [1] と [2] の間に挿入する
         *     <&zip_xy_scaler 倍率 除数>,
         *       速くする: <&zip_xy_scaler 3 2>   (1.5倍)
         *       遅くする: <&zip_xy_scaler 1 2>   (0.5倍)
         */

    /* --- レイヤー3（Enter長押し）中はスクロールになる ---------- */
    scroll_layer {

        /* スクロールにしたいレイヤー番号。複数可: layers = <2 3>;
         * スクロール不要ならこのブロックごと削除してよい */
        layers = <3>;

        /* ⚠ レイヤー別オーバーライドはベースの処理チェーンを
         *    「置き換える」ので、軸補正 [1] をここにも書かないと
         *    スクロール方向が反転する */
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>,

            /* スクロール量の調整。いちばん触る箇所。
             *   速すぎる → <&zip_xy_scaler 1 16>
             *   遅すぎる → <&zip_xy_scaler 1 4>
             * ここを入れないと猛烈な速度でスクロールする */
            <&zip_xy_scaler 1 8>,

            /* XY移動をホイール入力に変換。これ自体に設定項目はない */
            <&zip_xy_to_scroll_mapper>;
    };
};


/* ============================================================
 * タップ直後にもう一度押して長押しすると、ホールドではなく
 * タップ側のキーがリピートする（QMKのタップ後長押しと同じ挙動）。
 *   反応しない  → 300 へ増やす
 * ============================================================ */
&mt {
    quick-tap-ms = <200>;
};

&lt {
    quick-tap-ms = <200>;
};

