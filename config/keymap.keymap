#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/ {
    chosen {
        /* このキーマップは S Layout(44キー) の並びで書いてある。
         * シールド側の既定は L Layout なので、ここで上書きする。
         * 相互変換は torabo_tsuki_lp_layouts.dtsi の
         * position_map_1 (complete) が行うため、Studio で
         * 他のレイアウトを選んでも対応は保たれる。 */
        zmk,physical-layout = &physical_layout_s;
    };

    /* ============================================================
     * ZMK Studio 上の実機設定から復元したキーマップ。
     *
     * 並びは S Layout の物理配置そのまま:
     *   1行目  0-9    (左5 + 右5)   … 上段
     *   2行目  10-19  (左5 + 右5)   … ホームロウ(Mod-Tap)
     *   3行目  20-31  (左6 + 右6)   … 下段
     *   4行目  32-43  (左6 + 右6)   … 親指段
     *
     * XSに存在しないキーは &none。
     * コンボを書くときの key-positions もこの番号で指定できる。
     * ============================================================ */
    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: ベース。外側の列と最下段はホームロウモッド(Mod-Tap) */
        layer_0 {
            bindings = <
&mt LALT Q       &kp W            &kp E            &kp R            &kp T               &kp Y            &kp U            &kp I            &kp O            &kp P
&mt LCTRL A      &kp S            &kp D            &kp F            &kp G               &kp H            &kp J            &kp K            &kp L            &mt RCTRL MINUS
&mt LSHFT Z      &kp X            &kp C            &kp V            &kp B            &kp LANGUAGE_2      &kp LANGUAGE_1   &kp N            &kp M            &lt 3 COMMA      &kp DOT          &mt RSHFT FSLH
&kp TAB          &kp LALT         &kp LCTRL        &mo 2            &mo 3            &mt RGUI ESC        &kp SPACE        &lt 2 RET        &none            &none            &to 1            &kp BSPC
            >;
        };

        /* Layer 1: AML / To-Layer で有効化。F1-F12 とマウスボタン MB1-MB5 */
        layer_1 {
            bindings = <
&kp F1    &kp F2    &kp F3    &kp F4    &kp F5       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
&trans    &trans    &mkp MB2  &mkp MB1  &trans       &trans    &mkp MB1  &mkp MB2  &mkp MB3  &kp F11
&trans    &trans    &trans    &trans    &trans    &trans       &trans    &trans    &mkp MB4  &trans    &mkp MB5  &kp F12
&trans    &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        /* Layer 2: &mo 2 で有効化。数字・記号・矢印 */
        layer_2 {
            bindings = <
&kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(N4)     &kp LS(N5)        &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)
&kp N1         &kp N2         &kp N3         &kp N4         &kp N5            &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans
&kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &trans            &trans         &trans         &mkp MB1       &mkp MB2       &mkp MB3       &trans
&trans         &trans         &trans         &trans         &kp LG(SPACE)  &trans            &trans         &trans         &trans         &trans         &trans         &trans
            >;
        };

        /* Layer 3: &mo 3 / COMMA長押しで有効化。記号・括弧。スクロール層でもある */
        layer_3 {
            bindings = <
&kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(N4)     &kp LS(N5)        &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)
&kp GRAVE      &kp BSLH       &kp SEMI       &kp SQT        &kp EQUAL         &trans         &trans         &trans         &kp LBRC       &kp RBRC
&kp TILDE      &kp PIPE       &kp COLON      &kp DQT        &kp PLUS       &trans            &trans         &trans         &trans         &trans         &kp LBKT       &kp RBKT
&trans         &trans         &trans         &trans         &trans         &trans            &trans         &kp LG(SPACE)  &trans         &trans         &trans         &trans
            >;
        };
    };
};


/* ============================================================
 * トラックボール設定
 *   ノードのラベルは pointing_listener（trackball_listener ではない）
 *   定義元: boards/shields/torabo_tsuki_lp/torabo_tsuki_lp.dtsi
 *   ここを書き換えたら push → GitHub Actions → uf2 を Central 側に書き込み
 * ============================================================ */

&pointing_listener {

    /* --- 通常時（レイヤー3以外）の処理チェーン ---------------- */
    input-processors =

        /* [1] 軸の向き補正
         *     torabo_tsuki_lp_right.overlay と同じ内容。
         *     input-processors は「上書き」なので、ここに書かないと
         *     overlay 側の設定が消えて上下左右が反転する。
         *     ボールと逆に動く場合はここを調整:
         *       上下だけ反転     → INPUT_TRANSFORM_Y_INVERT
         *       左右だけ反転     → INPUT_TRANSFORM_X_INVERT
         *       縦横が入れ替わる → INPUT_TRANSFORM_XY_SWAP を | で追加
         */
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,

        /* [2] オートマウスレイヤー（AML）
         *     書式: <&zip_temp_layer レイヤー番号 タイムアウトms>
         *       レイヤー番号 … 1 = マウスボタンを置いたレイヤー
         *       タイムアウト … ボールが止まってから解除されるまでの時間
         *         短すぎ（クリック前に解除される） → 1000〜1500 へ
         *         長すぎ（タイピングに戻れない）   → 500 へ
         */
        <&zip_temp_layer 1 750>;

        /* [3] カーソル速度を変えたい場合は [1] と [2] の間に挿入する
         *     <&zip_xy_scaler 倍率 除数>,
         *       速くする: <&zip_xy_scaler 3 2>   (1.5倍)
         *       遅くする: <&zip_xy_scaler 1 2>   (0.5倍)
         */

    /* --- レイヤー3（Enter長押し）中はスクロールになる ---------- */
    scroll_layer {

        /* スクロールにしたいレイヤー番号。複数可: layers = <2 3>;
         * スクロール不要ならこのブロックごと削除してよい */
        layers = <3>;

        /* ⚠ レイヤー別オーバーライドはベースの処理チェーンを
         *    「置き換える」ので、軸補正 [1] をここにも書かないと
         *    スクロール方向が反転する */
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>,

            /* スクロール量の調整。いちばん触る箇所。
             *   速すぎる → <&zip_xy_scaler 1 16>
             *   遅すぎる → <&zip_xy_scaler 1 4>
             * ここを入れないと猛烈な速度でスクロールする */
            <&zip_xy_scaler 1 8>,

            /* XY移動をホイール入力に変換。これ自体に設定項目はない */
            <&zip_xy_to_scroll_mapper>;
    };
};


/* ============================================================
 * タップ直後にもう一度押して長押しすると、ホールドではなく
 * タップ側のキーがリピートする（QMKのタップ後長押しと同じ挙動）。
 *   反応しない  → 300 へ増やす
 * ============================================================ */
&mt {
    quick-tap-ms = <200>;
};

&lt {
    quick-tap-ms = <200>;
};

