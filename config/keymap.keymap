#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3    &kp N4    &kp N5                                                         &kp N6       &kp N7    &kp N8     &kp N9    &kp N0                &kp BSPC
&kp TAB    &kp Q      &kp W     &kp E     &kp R     &kp T                                                          &kp Y        &kp U     &kp I      &kp O     &kp P                 &kp BSPC
&kp CAPS   &kp A      &kp S     &kp D     &kp F     &kp G        &mkp LCLK                  &mkp RCLK              &kp H        &kp J     &kp K      &kp L     &kp SEMI              &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V     &kp B        &kp SPACE                  &kp RET                &kp N        &kp M     &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &kp RSHFT
&kp LCTRL  &kp LCTRL  &kp LGUI  &kp LALT  &kp BSPC  &lt 2 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &mt RSHIFT LANGUAGE_2  &lt 3 ENTER  &kp BSPC  &kp RALT   &kp RGUI  &kp RCTRL             &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans            &trans            &trans      &trans      &trans                      &trans          &trans         &trans            &trans             &trans         &trans
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                  &kp LS(N6)      &kp LS(N7)     &kp LS(N8)        &kp LS(N9)         &kp LS(N0)     &trans
&trans  &kp N1            &kp N2            &kp N3      &kp N4      &kp N5      &trans  &trans  &kp LEFT_BRACE  &kp MINUS      &kp EQUAL         &kp RIGHT_BRACE    &kp COLON      &trans
&trans  &kp N6            &kp N7            &kp N8      &kp N9      &kp N0      &trans  &trans  &kp LS(MINUS)   &kp LS(EQUAL)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
&trans  &trans            &trans            &trans      &trans      &trans      &trans  &trans  &kp TAB         &kp DEL        &trans            &trans             &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans        &trans        &trans                      &trans            &trans     &trans         &trans     &trans      &trans
&trans  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5                      &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE  &trans
&trans  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10     &trans  &trans  &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB     &trans
&trans  &kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE    &trans
&trans  &trans   &trans   &trans        &kp DELETE    &kp TAB     &trans  &trans  &trans            &trans     &trans         &trans     &trans      &trans
            >;
        };
    };
};

/* ============================================================
 * トラックボール設定
 *   ここを書き換えたら push → GitHub Actions → uf2 を Central 側に書き込み
 * ============================================================ */

&trackball_listener {

    /* --- 通常時（レイヤー3以外）の処理チェーン ---------------- */
    input-processors =

        /* [1] 軸の向き補正
         *     右手側トラックボール用。これを消すと上下左右が反転する。
         *     ボールの動きと逆に動く場合はここを調整:
         *       上下だけ反転  → INPUT_TRANSFORM_Y_INVERT
         *       左右だけ反転  → INPUT_TRANSFORM_X_INVERT
         *       縦横が入れ替わる → INPUT_TRANSFORM_XY_SWAP を追加
         */
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,

        /* [2] オートマウスレイヤー（AML）
         *     書式: <&zip_temp_layer レイヤー番号 タイムアウトms>
         *       レイヤー番号 … 1 = マウスボタンを置いたレイヤー
         *       タイムアウト … ボールが止まってから解除されるまでの時間
         *         短すぎ（クリック前に解除される） → 1000〜1500 へ
         *         長すぎ（タイピングに戻れない）   → 500 へ
         */
        <&zip_temp_layer 1 750>;

        /* [3] カーソル速度を変えたい場合はここに追加
         *     <&zip_xy_scaler 倍率 除数>
         *       速くする: <&zip_xy_scaler 3 2>  (1.5倍)
         *       遅くする: <&zip_xy_scaler 1 2>  (0.5倍)
         *     ※ [1] の後、[2] の前に挿入すること
         */

    /* --- レイヤー3（Enter長押し）中はスクロールになる ---------- */
    scroll_layer {

        /* スクロールにしたいレイヤー番号。
         * 複数指定も可: layers = <2 3>;
         * スクロール不要ならこのブロックごと削除してよい */
        layers = <3>;

        /* ⚠ オーバーライドはベースの処理チェーンを「置き換える」ので、
         *    軸補正 [1] をここにも書かないとスクロール方向が反転する */
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,

            /* スクロール量の調整。ここが最も触る箇所。
             *   速すぎる → <&zip_xy_scaler 1 16>
             *   遅すぎる → <&zip_xy_scaler 1 4>
             * 逆方向にしたい（ナチュラルスクロール的に）場合は
             * 上の transform から Y_INVERT を外す/足すで調整 */
            <&zip_xy_scaler 1 8>,

            /* XY移動をホイール入力に変換。これ自体に設定項目はない */
            <&zip_xy_to_scroll_mapper>;
    };
};


/* ============================================================
 * オートマウスレイヤーの細かい挙動
 * ============================================================ */

&zip_temp_layer {

    /* キー入力直後、この時間はAMLを起動しない（誤爆防止）。
     *   タイピング中に手が触れて勝手にマウス層になる → 300〜500 へ増やす
     *   マウスに切り替えるまでがもたつく           → 100 へ減らす
     *   0 にすると常に即座に起動する */
    require-prior-idle-ms = <200>;

    /* AML中に押しても「レイヤーを解除しない」キー位置。
     *   ここに入れ忘れたキーは、押した瞬間に通常レイヤーへ戻る。
     *   → クリックできない / 修飾キーが効かない ときはここを疑う
     *
     *   位置番号 = keymap の bindings を先頭から0始まりで数えた順番
     *   （1〜2行目が12個、3行目以降が14個ずつ。XSは24〜65が実在）
     *
     *   逆に文字キーはここに入れないこと。
     *   「文字を打ったら即マウス層から抜ける」のがAMLの利点なので。 */
    excluded-positions = 
        27 28    // 左手 D / F（レイヤー1の右クリック・左クリック）
        30 31    // 内側キー（レイヤー0から透過してくるクリック）
        33 34 35 // 右手 J / K / L → MB1 / MB2 / MB3
        47 49    // 右手 M / .     → MB4 / MB5
        38       // LShift
        50 51    // RShift（mt含む）
        52 53    // LCtrl
        54 55    // LGUI / LAlt
        58 59    // 親指の Shift(mt)
        62 63    // RAlt / RGUI
        64 65    // RCtrl
    >;
};
